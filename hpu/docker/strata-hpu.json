{
 "exe": "/opt/strata/build-release/strata-hpu",
 "cwd": "/opt/strata",
 "args": [
  "--native",
  "${MODEL_GGUF}",
  "--fp8-experts",
  "--expert-cache-mib",
  "64",
  "--max-context",
  "262144",
  "--prompt-cache",
  "0",
  "--check-logits",
  "--ple-io",
  "ram",
  "--host-limit-mib",
  "65536",
  "--hbm-limit-mib",
  "94208",
  "--pinned-limit-mib",
  "3072",
  "--prefill",
  "8192",
  "--vram-reserve-mib",
  "2048",
  "--spec-prob"
 ],
 "env": {
  "STRATA_HPU_SIMD_NORM": "1",
  "STRATA_HPU_FUSED_FP8": "1",
  "STRATA_HPU_FAST_BINDINGS": "1",
  "STRATA_HPU_DIRECT_EXPERTS": "1",
  "STRATA_HPU_PACKED_IO": "1",
  "STRATA_HPU_CHAIN": "1",
  "STRATA_HPU_EVENT_POLL": "1",
  "STRATA_HPU_SIMD_GDN": "1",
  "STRATA_HPU_CACHED_GDN_STEP": "1",
  "STRATA_HPU_RESIDENT_IQ4": "1",
  "STRATA_HPU_QSA_DEVICE": "1",
  "STRATA_HPU_Q8_SHUFFLE": "1",
  "STRATA_HPU_MERGED_GEMM": "1",
  "STRATA_HPU_GDN_STEP_PIPE": "1",
  "STRATA_HPU_Q8_PACKED": "1",
  "STRATA_HPU_HC_FUSED": "1",
  "STRATA_HPU_MOE_TAIL_FUSED": "1",
  "STRATA_HPU_QSA_HOST_PACK": "1",
  "STRATA_HPU_FAST_GREEDY": "1",
  "STRATA_HPU_DFLASH": "${DFLASH_DIR}",
  "STRATA_HPU_DFLASH_VERIFY": "1",
  "STRATA_HPU_EMBED_RAM": "0",
  "STRATA_HPU_PREFILL_FINAL": "1",
  "STRATA_HPU_MOE_MME": "1",
  "STRATA_HPU_GDN_CHUNKED": "1",
  "STRATA_HPU_PLE_GATE_SIMD": "1",
  "STRATA_HPU_PREFILL_LAST_HEAD": "1",
  "STRATA_HPU_GDN_NORM_FAST": "1",
  "STRATA_HPU_MOE_SLICE": "1",
  "STRATA_HPU_FAST_SIGMOID": "1",
  "STRATA_HPU_QSA_DEVICE_GATHER": "1",
  "STRATA_HPU_QSA_DEVICE_SELECT": "1",
  "STRATA_HPU_QSA_SDPA": "1",
  "STRATA_HPU_MOE_PLACE": "1",
  "STRATA_HPU_ROW_NORM_FAST": "1",
  "STRATA_HPU_MOE_MME_TILE": "128",
  "STRATA_HPU_QSA_KV_FP8": "1",
  "STRATA_HPU_QSA_INDEX_THREADS": "12",
  "STRATA_HPU_QSA_EXACT_INDEX": "1",
  "STRATA_HPU_QSA_SDPA_MAX_KEYS": "65536",
  "STRATA_HPU_QSA_DECODE_SELECT": "1",
  "STRATA_HPU_DFLASH_BLOCK": "4",
  "STRATA_HPU_CHAIN_HEAD": "1",
  "STRATA_HPU_HC_DECODE_TPC": "1",
  "STRATA_HPU_QSA_SDPA_FOLD": "1",
  "STRATA_HPU_QSA_SELECT_KEEP_MIB": "1024",
  "STRATA_HPU_QSA_SPARSE": "1",
  "STRATA_HPU_GDN_STEP_ROWS": "1",
  "STRATA_HPU_GEMV_PARTS_GU_WINDOW": "1"
 },
 "tokenizer": "${TOKENIZER_DIR}",
 "model_name": "qwen3.8-flash-next-uncensored-iq4_xs",
 "log": "/var/log/strata/strata-hpu-engine.log",
 "backend": "hpu",
 "host": "0.0.0.0",
 "api_monitor": true
}

# Keep both source checkouts byte-identical. Patch only verified build copies:
# unsigned IQ3_S sign packing, exceptional Q8_K and Q8_0 guards. Q8_0 keeps
# the original caller's normal-block quantizer, including its tie rounding.
get_target_property(strata_ggml_source ggml-base SOURCE_DIR)
set(strata_x86_quants "${strata_ggml_source}/ggml-cpu/arch/x86/quants.c")
file(SHA256 "${strata_x86_quants}" strata_hash)
if(NOT strata_hash STREQUAL "3c489fdc77e3ab484a5f188bff9c60c0e9483c951ed65c1a562a04c249d5628e")
  message(FATAL_ERROR "Unexpected pinned ggml x86 quants source for CPU safety patch")
endif()
file(READ "${strata_x86_quants}" strata_code)
foreach(index IN ITEMS 1 3)
  string(REPLACE "(signs[${index}] << 16)" "((uint32_t) signs[${index}] << 16)" strata_code "${strata_code}")
endforeach()
foreach(header IN ITEMS quants.h ggml-cpu-impl.h)
  string(REPLACE "\"../../${header}\"" "\"${strata_ggml_source}/ggml-cpu/${header}\"" strata_code "${strata_code}")
endforeach()
set(strata_safe_quants "${CMAKE_CURRENT_BINARY_DIR}/cpu-safety/x86-quants.c")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/cpu-safety")
file(WRITE "${strata_safe_quants}" "${strata_code}")
get_target_property(strata_cpu_sources ggml-cpu SOURCES)
set(strata_cpu_safe_sources)
set(strata_replaced 0)
foreach(source IN LISTS strata_cpu_sources)
  if(source MATCHES "ggml-cpu/arch/x86/quants\\.c$")
    list(APPEND strata_cpu_safe_sources "${strata_safe_quants}")
    math(EXPR strata_replaced "${strata_replaced}+1")
  else()
    list(APPEND strata_cpu_safe_sources "${source}")
  endif()
endforeach()
if(NOT strata_replaced EQUAL 1)
  message(FATAL_ERROR "Could not identify the single ggml-cpu x86 quant source")
endif()
set_property(TARGET ggml-cpu PROPERTY SOURCES "${strata_cpu_safe_sources}")

set(strata_native "${CMAKE_CURRENT_SOURCE_DIR}/../src/kernels/cpu/native_expert.cpp")
file(SHA256 "${strata_native}" strata_hash)
if(NOT strata_hash STREQUAL "f299e7e97b67132912371176eb3ebb1dfaa892e0493c8cbfe0c10761f9b2117e")
  message(FATAL_ERROR "Unexpected original Strata CPU source for quant guard")
endif()
file(READ "${strata_native}" strata_code)
string(REPLACE "\r\n" "\n" strata_code "${strata_code}")
set(strata_code "#include \"strata/hpu/cpu_quant_guard.hpp\"\n${strata_code}")
foreach(pair IN ITEMS "act=gu_act=n_embd" "h=d_act=n_ff")
  string(REPLACE "=" ";" fields "${pair}")
  list(GET fields 0 role)
  list(GET fields 1 type)
  list(GET fields 2 width)
  set(signature "void native_quant_${role}(const NativeFmt& f, const float* ${role}, void* dst) {")
  if(role STREQUAL "act")
    set(argument x)
    set(signature "void native_quant_act(const NativeFmt& f, const float* x, void* dst) {")
  else()
    set(argument h)
  endif()
  string(FIND "${strata_code}" "${signature}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Native CPU quantizer signature changed")
  endif()
  string(REPLACE "${signature}" "${signature}\n    if (f.${type} == (int) GGML_TYPE_Q8_0 && strata::hpu::guard_q8_0(${argument}, dst, f.${width}, traits(f.${type})->from_float)) return;\n    if (f.${type} == (int) GGML_TYPE_Q8_K && strata::hpu::guard_q8k(${argument}, dst, f.${width})) return;" strata_code "${strata_code}")
endforeach()
set(strata_safe_native "${CMAKE_CURRENT_BINARY_DIR}/cpu-safety/native-expert.cpp")
file(WRITE "${strata_safe_native}" "${strata_code}")

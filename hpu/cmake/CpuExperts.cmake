# Original Strata CPU arithmetic and dispatch, byte-identical sources. Wide ISA
# flags are isolated exactly as in upstream; probes/pool keep the baseline ISA.
include(cmake/CpuSafety.cmake)
add_library(strata_hpu_cpu_kernels STATIC "${strata_safe_native}" src/cpu_quant_guard.cpp)
foreach(name IN ITEMS expert pool expert_layout q2_avx2 iq_avx512 iq_avx2 kq_avx2 kq_avx1 q2_avx1 iq_avx1 nvfp4_avx512 nvfp4_avx2)
  target_sources(strata_hpu_cpu_kernels PRIVATE "../src/kernels/cpu/${name}.cpp")
endforeach()
target_include_directories(strata_hpu_cpu_kernels PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/../include" "${CMAKE_CURRENT_SOURCE_DIR}/include" PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/../third_party/ggml")
target_link_libraries(strata_hpu_cpu_kernels PUBLIC ggml-cpu ggml-base Threads::Threads)
target_compile_definitions(strata_hpu_cpu_kernels PUBLIC STRATA_NATIVE_EXPERTS=1)
foreach(name IN ITEMS expert iq_avx512 nvfp4_avx512)
  set_source_files_properties("../src/kernels/cpu/${name}.cpp" PROPERTIES COMPILE_OPTIONS "-mavx512f;-mavx512bw;-mavx512vl;-mavx512dq;-mavx512vnni;-mavx512vbmi;-mf16c;-mfma")
endforeach()
foreach(name IN ITEMS q2_avx2 iq_avx2 kq_avx2 nvfp4_avx2)
  set_source_files_properties("../src/kernels/cpu/${name}.cpp" PROPERTIES COMPILE_OPTIONS "-mavx2;-mfma;-mf16c")
endforeach()
set_source_files_properties(../src/kernels/cpu/kq_avx1.cpp PROPERTIES COMPILE_OPTIONS "-mavx")
foreach(name IN ITEMS q2_avx1 iq_avx1)
  set_source_files_properties("../src/kernels/cpu/${name}.cpp" PROPERTIES COMPILE_OPTIONS "-msse4.2;-mavx;-mno-avx2;-mno-fma;-mno-f16c")
endforeach()
# Optional AVX-VNNI copies are not required on the target Haswell Xeon.
set_source_files_properties(../src/kernels/cpu/q2_avx2.cpp ../src/kernels/cpu/iq_avx2.cpp PROPERTIES COMPILE_DEFINITIONS "STRATA_AVXVNNI=0")
add_library(strata_hpu_cpu_experts STATIC src/cpu_experts.cpp)
target_link_libraries(strata_hpu_cpu_experts PUBLIC strata_hpu_weights strata_hpu_cpu_kernels)
target_compile_options(strata_hpu_cpu_experts PRIVATE -Wall -Wextra -Wpedantic -Werror)
add_executable(strata-hpu-cpu-experts-test tests/cpu_experts.cpp)
target_link_libraries(strata-hpu-cpu-experts-test PRIVATE strata_hpu_cpu_experts)
target_compile_options(strata-hpu-cpu-experts-test PRIVATE -Wall -Wextra -Wpedantic -Werror)
add_executable(strata-hpu-cpu-affinity-test tests/cpu_affinity.cpp)
target_link_libraries(strata-hpu-cpu-affinity-test PRIVATE strata_hpu_cpu_experts)
target_compile_options(strata-hpu-cpu-affinity-test PRIVATE -Wall -Wextra -Wpedantic -Werror)
add_test(NAME hpu_cpu_affinity COMMAND strata-hpu-cpu-affinity-test)
set_tests_properties(hpu_cpu_affinity PROPERTIES LABELS "host" TIMEOUT 120)
add_test(NAME hpu_cpu_experts COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/cpu_experts.py" "$<TARGET_FILE:strata-hpu-cpu-experts-test>")
set_tests_properties(hpu_cpu_experts PROPERTIES LABELS "host" TIMEOUT 180 ENVIRONMENT "PYTHONDONTWRITEBYTECODE=1")
add_test(NAME hpu_cpu_experts_nvfp4 COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/cpu_experts.py" "$<TARGET_FILE:strata-hpu-cpu-experts-test>" --nvfp4)
set_tests_properties(hpu_cpu_experts_nvfp4 PROPERTIES LABELS "host" TIMEOUT 180 ENVIRONMENT "PYTHONDONTWRITEBYTECODE=1")
foreach(name IN ITEMS iq_avx2 q2_bitplane)
  add_executable(strata-hpu-${name}-parity-test "../src/kernels/cpu/${name}_parity.cpp")
  target_link_libraries(strata-hpu-${name}-parity-test PRIVATE strata_hpu_cpu_kernels)
  add_test(NAME hpu_${name}_parity COMMAND strata-hpu-${name}-parity-test)
  set_tests_properties(hpu_${name}_parity PROPERTIES LABELS "host" TIMEOUT 180)
endforeach()
